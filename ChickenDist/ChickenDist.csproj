<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><ApplicationIcon>logo.ico</ApplicationIcon>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>ChickenDist</AssemblyName>
    <RootNamespace>ChickenDist</RootNamespace>
    <Nullable>disable</Nullable>
    <LangVersion>9.0</LangVersion>
    <ApplicationDefaultFont>Segoe UI, 9.75pt</ApplicationDefaultFont>
    <StartupObject>ChickenDist.Program</StartupObject>
    <CodePage>65001</CodePage>
    <Utf8Output>true</Utf8Output>
    <AppConfig>app.config</AppConfig>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System.Configuration" />
    <Reference Include="System.Management" />
    <Reference Include="System.Security" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <Reference Include="System.Net.Http" />
    <EmbeddedResource Include="Forms\driver_sales.html" />
    <EmbeddedResource Include="Forms\accountant_orders.html" />
    <!-- QRCoder.dll محجوزة داخل الـ EXE نفسه حتى لا يحتاج المستخدم لتوزيعها -->
    <EmbeddedResource Include="QRCoder.dll" />
    <None Include="app.config" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="QRCoder" Version="1.4.3" />
  </ItemGroup>
</Project>
