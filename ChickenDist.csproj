<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><ApplicationIcon>logo.ico</ApplicationIcon>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>ProSoft</AssemblyName>
    <RootNamespace>ChickenDist</RootNamespace>
    <Nullable>disable</Nullable>
    <LangVersion>9.0</LangVersion>
    <ApplicationDefaultFont>Segoe UI, 9.75pt</ApplicationDefaultFont>
    <StartupObject>ChickenDist.Program</StartupObject>
    <CodePage>65001</CodePage>
  </PropertyGroup>
  <!-- استثناء مجلد ChickenDist الفرعي القديم من الـ Compile لتفادي التعارض -->
  <ItemGroup>
    <Compile Remove="ChickenDist\**\*" />
    <EmbeddedResource Remove="ChickenDist\**\*" />
    <None Remove="ChickenDist\**\*" />
    <Content Remove="ChickenDist\**\*" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="System.Configuration" />
    <Reference Include="System.Management" />
    <Reference Include="System.Security" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Web.Extensions" />
    <EmbeddedResource Include="Forms\driver_sales.html" />
    <EmbeddedResource Include="Forms\accountant_orders.html" />
    <EmbeddedResource Include="MobileApp\index.html" />
    <EmbeddedResource Include="MobileApp\sw.js" />
    <EmbeddedResource Include="MobileApp\firebase.json" />
    <EmbeddedResource Include="MobileApp\database.rules.json" />
    <EmbeddedResource Include="MobileApp\firestore.rules" />
    <EmbeddedResource Include="MobileApp\manifest.json" />
    <EmbeddedResource Include="MobileApp\logo.png" />
    <EmbeddedResource Include="pro_soft_logo.png" />
    <!-- QRCoder.dll محجوزة داخل الـ EXE نفسه حتى لا يحتاج المستخدم لتوزيعها -->
    <EmbeddedResource Include="QRCoder.dll" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="QRCoder" Version="1.4.3" />
    <PackageReference Include="Obfuscar" Version="2.2.38">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <!-- Copy the bot and MobileApp folders automatically to the build output directory -->
  <ItemGroup>
    <None Include="bot\*.js;bot\*.json;bot\*.txt;bot\public\**\*" Exclude="bot\package-lock.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="MobileApp\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>
