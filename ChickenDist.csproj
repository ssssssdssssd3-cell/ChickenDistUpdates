<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <ApplicationIcon>ChickenDist\logo.ico</ApplicationIcon>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>ChickenDist</AssemblyName>
    <RootNamespace>ChickenDist</RootNamespace>
    <Nullable>disable</Nullable>
    <LangVersion>9.0</LangVersion>
    <ApplicationDefaultFont>Segoe UI, 9.75pt</ApplicationDefaultFont>
    <StartupObject>ChickenDist.Program</StartupObject>
    <CodePage>65001</CodePage>
    <Utf8Output>true</Utf8Output>
    <AppConfig>ChickenDist\app.config</AppConfig>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System.Configuration" />
    <Reference Include="System.Management" />
    <Reference Include="System.Security" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <Reference Include="System.Net.Http" />
    <EmbeddedResource Include="ChickenDist\Forms\driver_sales.html" Link="Forms\driver_sales.html" />
    <EmbeddedResource Include="ChickenDist\Forms\accountant_orders.html" Link="Forms\accountant_orders.html" />
    <EmbeddedResource Include="ChickenDist\pro_soft_logo.png" />
    <EmbeddedResource Include="ChickenDist\QRCoder.dll" />
    <None Include="ChickenDist\app.config" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="QRCoder" Version="1.4.3" />
  </ItemGroup>
  <!-- استبعاد النسخة القديمة المكررة — المصدر الوحيد: ChickenDist/ -->
  <ItemGroup>
    <Compile Remove="Core/**" />
    <Compile Remove="Forms/**" />
    <Compile Remove="DAL/**" />
    <Compile Remove="Program.cs" />
    <Compile Remove="DbSetup.cs" />
    <Compile Remove="ChickenDist\obj\**" />
    <Compile Remove="ChickenDist\bin\**" />
    <Compile Remove="**\*.bak" />
    <EmbeddedResource Remove="Forms/**" />
    <None Remove="App.config" />
  </ItemGroup>
</Project>
