<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <connectionStrings>
    <add name="MainDB"
         connectionString="Data Source=.;Initial Catalog=ChickenDist;Integrated Security=True;Connect Timeout=30;"
         providerName="System.Data.SqlClient" />
  </connectionStrings>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8"/>
  </startup>
  <appSettings>
    <add key="CompanyName" value="شركة توزيع الكتاكيت"/>
    <add key="Currency" value="جنيه"/>
    <!-- إعدادات الميزان الإلكتروني -->
    <add key="ScaleEnabled" value="false"/>
    <add key="ScaleComPort" value="COM3"/>
    <add key="ScaleBaudRate" value="9600"/>
    <!-- إعدادات الطباعة الحرارية -->
    <add key="ThermalPrinterEnabled" value="false"/>
    <add key="ThermalPrinterName" value=""/>
    <add key="ThermalPaperWidth" value="80"/>
  </appSettings>
</configuration>
