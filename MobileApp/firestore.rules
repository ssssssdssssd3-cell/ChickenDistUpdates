rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /store_catalog/{document=**} {
      allow read, write: if true;
    }
    match /store_config/{document=**} {
      allow read, write: if true;
    }
    match /online_orders/{orderId} {
      allow read, write: if true;
    }
    match /{document=**} {
      allow read, write: if true;
    }
  }
}