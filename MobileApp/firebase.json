{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "*.bat",
      "*.ps1",
      "*.cmd",
      "*.exe",
      "*.rules.json",
      "*.rules"
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate, max-age=0, s-maxage=0"
          },
          {
            "key": "Pragma",
            "value": "no-cache"
          },
          {
            "key": "Expires",
            "value": "0"
          },
          {
            "key": "Surrogate-Control",
            "value": "no-store"
          },
          {
            "key": "Access-Control-Allow-Origin",
            "value": "*"
          }
        ]
      }
    ],
    "rewrites": [
      { "source": "/store", "destination": "/store.html" },
      { "source": "/store/**", "destination": "/store.html" },
      { "source": "/upload", "destination": "/upload.html" },
      { "source": "/upload/**", "destination": "/upload.html" },
      { "source": "/activities", "destination": "/activities/index.html" },
      { "source": "/coffee", "destination": "/activities/activity-coffee.html" },
      { "source": "/restaurant", "destination": "/activities/activity-restaurant.html" },
      { "source": "/supermarket", "destination": "/activities/activity-supermarket.html" },
      { "source": "/fashion", "destination": "/activities/activity-fashion.html" },
      { "source": "/mobiles", "destination": "/activities/activity-mobiles.html" },
      { "source": "/butchery", "destination": "/activities/activity-butchery.html" },
      { "source": "/autoparts", "destination": "/activities/activity-autoparts.html" }
    ]
  },
  "database": {
    "rules": "database.rules.json"
  },
  "firestore": {
    "rules": "firestore.rules"
  }
}