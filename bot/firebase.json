{
  "hosting": {
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      { "source": "/mobile", "destination": "/mobile.html" },
      { "source": "/admin", "destination": "/admin.html" },
      { "source": "/store", "destination": "/store.html" },
      { "source": "/store/**", "destination": "/store.html" }
    ]
  }
}
